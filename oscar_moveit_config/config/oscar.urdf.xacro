<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="oscar">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import oscar urdf file -->
    <xacro:include filename="$(find oscar_description)/urdf/oscar.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="oscar.ros2_control.xacro" />


    <xacro:oscar_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
