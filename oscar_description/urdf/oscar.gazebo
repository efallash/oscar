<robot xmlns:xacro="http://ros.org/wiki/xacro">

<!-- oscar.gazebo Gazebo plugins and properties for OSCAR robot-->
<!-- OSCAR Open Source Cognitive Applied Robot -->
<!-- Author Emanuel Fallas -->
<!-- email efallashdez@gmail.com -->
<!-- Published under GNU GPLv3 license -->

  <!-- Control plugin --> 
  <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
          <parameters>$(find oscar_control)/config/oscar_controllers.yaml</parameters>
        </plugin>
  </gazebo>

  <!-- Depth Camera Plugin -->
  <gazebo reference="depth_camera_link">
    <sensor type="depth" name="depth_camera">
      <update_rate>20.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.51844</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.03</near>
          <far>2000</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range 0,1. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="depth_plugin" filename="libgazebo_ros_camera.so">
        <cameraName>kinect</cameraName>
        <frameName>depth_optical_frame</frameName>
        <imageTopicName>/kinect/color/image_raw</imageTopicName>
        <cameraInfoTopicName>/kinect/color/camera_info</cameraInfoTopicName>
        <depthImageTopicName>/kinect/depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>/kinect/depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>/kinect/depth/points</pointCloudTopicName>

        <ros>
          <namespace>oscar</namespace>
          <remapping>depth_camera/image_raw:=kinect/color/image_raw</remapping>
          <remapping>depth_camera/depth/image_raw:=kinect/depth/image_raw</remapping>
          <remapping>depth_camera/camera_info:=kinect/color/camera_info</remapping>
          <remapping>depth_camera/depth/camera_info:=kinect/depth/camera_info</remapping>
          <remapping>depth_camera/points:=kinect/depth/points</remapping>
        </ros>

        
        <pointCloudCutoff>0.05</pointCloudCutoff>
        <hackBaseline>0.07</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>


  <!-- RGB Camera Gazebo Plugin -->
  <gazebo reference="rgb_camera_link">
    <sensor type="camera" name="camera_rgb">
      <update_rate>15.0</update_rate>
      <always_on>0</always_on>
      <camera name="head">
        <horizontal_fov>1.085594795</horizontal_fov>
        <image>
          <width>3280</width>
          <height>2464</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <!-- Noise is sampled independently per pixel on each frame.
               That pixel's noise value is added to each of its color
               channels, which at that point lie in the range 0,1. -->
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <cameraName>camera/rgb</cameraName>
        <frameName>rgb_camera_link</frameName>
        <ros>
          <namespace>oscar</namespace>
          <remapping>camera_rgb/image_raw:=camera/rgb/image_raw</remapping>
          <remapping>camera_rgb/camera_info:=camera/rgb/camera_info</remapping>
        </ros>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <hackBaseline>0.07</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>



</robot>
